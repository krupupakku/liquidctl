# Systemd USER service for running the monitor when liquidctl lives inside a
# distrobox container (the typical SteamOS setup).
#
# systemd is not available *inside* the container, so this unit runs on the
# HOST and uses `distrobox enter` to execute the script inside the container
# named below. Because distrobox shares your home directory, the paths under
# /home/<user> are the same on the host and in the container.
#
# This points ExecStart directly at the script inside the liquidctl checkout,
# so a plain `git pull` updates both the driver fix and the script (no copying
# needed). The venv only needs liquidctl (editable, from the checkout), pillow
# and psutil installed.
#
# Install (run these on the HOST, i.e. outside the container):
#   mkdir -p ~/.config/systemd/user
#   cp kraken-lcd-monitor.distrobox.service ~/.config/systemd/user/kraken-lcd-monitor.service
#   # let the service start at boot without an interactive login:
#   loginctl enable-linger "$USER"
#   systemctl --user daemon-reload
#   systemctl --user enable --now kraken-lcd-monitor
#
# Adjust the container name (liquictl-box), the username (deck), the checkout
# path and the venv path below to match your setup.

[Unit]
Description=Kraken LCD CPU/GPU temperature monitor (via distrobox)

[Service]
Type=simple
ExecStart=/usr/bin/distrobox enter liquictl-box -- /home/deck/kraken-lcd-monitor/venv/bin/python3 /home/deck/Developer/liquidctl/extra/contrib/kraken-lcd-monitor/kraken_lcd_monitor.py --match kraken --interval 2
# restore the stock "liquid" screen when the service is stopped manually;
# wrapped in `timeout` and capped by TimeoutStopSec so it can never hang the
# system shutdown (podman/the container may already be tearing down then, and
# restoring the screen at poweroff is pointless anyway)
ExecStopPost=-/usr/bin/timeout 8 /usr/bin/distrobox enter liquictl-box -- /home/deck/kraken-lcd-monitor/venv/bin/liquidctl --match kraken set lcd screen liquid
TimeoutStopSec=12s
Restart=on-failure

[Install]
WantedBy=default.target
